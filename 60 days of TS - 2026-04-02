/**
 * deepClone - shallow-friendly deep clone with modern fallback.
 *
 * Uses global structuredClone when available (preserves Dates/Maps/Sets/TypedArrays/etc).
 * Falls back to JSON round-trip (loses functions, Symbols, non-JSON types).
 *
 * @example
 * const a = { d: new Date(), m: new Map([['k','v']]) };
 * const b = deepClone(a);
 *
 * @param value - value to clone
 * @returns a deep-cloned copy of the input (type-preserved when supported)
 */
export default function deepClone<T>(value: T): T {
  // Primitives & functions return as-is
  if (value === null || typeof value !== 'object') return value;
  const sc = (globalThis as any).structuredClone;
  if (typeof sc === 'function') {
    return sc(value) as T;
  }
  // JSON fallback (best-effort)
  try {
    return JSON.parse(JSON.stringify(value)) as T;
  } catch {
    // Last resort: shallow copy for objects/arrays
    if (Array.isArray(value)) return (value.slice() as unknown) as T;
    return ({ ...((value as unknown) as Record<string, unknown>) } as T);
  }
}