/**
 * retryWithBackoff.ts
 * 2026-05-15
 *
 * Retry an async function with exponential backoff, optional jitter and hook.
 *
 * @template T
 * @param fn - async function to execute
 * @param opts.retries - number of retries (default 3)
 * @param opts.delay - initial delay in ms (default 200)
 * @param opts.factor - exponential factor (default 2)
 * @param opts.maxDelay - maximum delay in ms (default 10000)
 * @param opts.jitter - apply jitter [0.5..1.5] (default true)
 * @param opts.onRetry - optional callback(err, attempt) invoked before waiting
 * @returns Promise<T>
 */
export async function retryWithBackoff<T>(
  fn: () => Promise<T>,
  opts: {
    retries?: number;
    delay?: number;
    factor?: number;
    maxDelay?: number;
    jitter?: boolean;
    onRetry?: (err: unknown, attempt: number) => void;
  } = {}
): Promise<T> {
  const {
    retries = 3,
    delay = 200,
    factor = 2,
    maxDelay = 10000,
    jitter = true,
    onRetry,
  } = opts;

  for (let attempt = 0; ; attempt++) {
    try {
      return await fn();
    } catch (err) {
      if (attempt >= retries) throw err;
      onRetry?.(err, attempt + 1);
      const base = Math.min(maxDelay, delay * Math.pow(factor, attempt));
      const next = jitter ? base * (0.5 + Math.random()) : base;
      await new Promise((res) => setTimeout(res, Math.round(next)));
    }
  }
}