/**
 * memoizeAsync - deduplicates concurrent async calls and optionally caches results.
 *
 * @template F - async function type (returns Promise).
 * @param fn - async function to memoize.
 * @param options.key - optional key function (defaults to JSON.stringify(args)).
 * @param options.ttl - optional cache TTL in ms; if omitted, result is cached indefinitely.
 * @returns a function with same signature as `fn`.
 *
 * Behavior:
 * - Concurrent calls with the same key return the same in-flight Promise.
 * - If ttl is provided, cached entries expire after ttl ms.
 * - If the wrapped promise rejects, the cache entry is removed to allow retries.
 */
export function memoizeAsync<F extends (...args: any[]) => Promise<any>>(
  fn: F,
  options?: { key?: (...args: Parameters<F>) => string; ttl?: number }
): F {
  const cache = new Map<string, { p: Promise<any>; expires?: number }>();
  const keyFn = options?.key ?? ((...a: Parameters<F>) => JSON.stringify(a));
  return (async (...args: Parameters<F>) => {
    const key = keyFn(...args);
    const now = Date.now();
    const existing = cache.get(key);
    if (existing) {
      if (!existing.expires || existing.expires > now) return existing.p;
      cache.delete(key);
    }
    const p = fn(...args);
    cache.set(key, { p, expires: options?.ttl ? now + options.ttl : undefined });
    p.catch(() => cache.delete(key));
    return p;
  }) as F;
}