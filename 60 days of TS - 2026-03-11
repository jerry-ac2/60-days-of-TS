/**
 * retry - retry an async function with exponential backoff and optional jitter.
 *
 * @template T
 * @param {() => Promise<T>} fn - Async function to retry.
 * @param {object} [opts]
 * @param {number} [opts.attempts=3] - Total attempts (initial + retries).
 * @param {number} [opts.delay=200] - Initial delay in ms.
 * @param {number} [opts.factor=2] - Backoff multiplier per retry.
 * @param {number} [opts.maxDelay=10000] - Maximum delay cap in ms.
 * @param {boolean} [opts.jitter=true] - Add random jitter up to ±50% of delay.
 * @param {(e: any, attempt: number) => boolean} [opts.shouldRetry] - Optional predicate to decide retry.
 * @returns {Promise<T>}
 *
 * Example:
 * await retry(() => fetch(url).then(r => r.json()), { attempts: 5, delay: 300 });
 */
export async function retry<T>(
  fn: () => Promise<T>,
  {
    attempts = 3,
    delay = 200,
    factor = 2,
    maxDelay = 10000,
    jitter = true,
    shouldRetry,
  }: {
    attempts?: number;
    delay?: number;
    factor?: number;
    maxDelay?: number;
    jitter?: boolean;
    shouldRetry?: (e: any, attempt: number) => boolean;
  } = {}
): Promise<T> {
  let attempt = 0;
  let lastErr: any;
  while (attempt < attempts) {
    try {
      return await fn();
    } catch (e) {
      attempt++;
      lastErr = e;
      if (attempt >= attempts) break;
      if (shouldRetry && !shouldRetry(e, attempt)) break;
      let wait = Math.min(delay * Math.pow(factor, attempt - 1), maxDelay);
      if (jitter) {
        const jitterFactor = 0.5 + Math.random(); // 0.5..1.5
        wait = Math.round(wait * jitterFactor);
      }
      await new Promise((res) => setTimeout(res, wait));
    }
  }
  throw lastErr;
}