/**
 * 2026-03-13 — retryAsync utility
 *
 * Retry an async function with exponential backoff and optional jitter.
 *
 * @template T
 * @param {() => Promise<T>} fn - The async function to retry.
 * @param {{retries?: number, initialDelayMs?: number, backoff?: number, jitter?: boolean, onRetry?: (err: any, attempt: number) => void}} [opts]
 * @returns {Promise<T>}
 *
 * Usage:
 * await retryAsync(() => fetch(...), { retries: 5, initialDelayMs: 100, jitter: true });
 */
export async function retryAsync<T>(
  fn: () => Promise<T>,
  opts: {
    retries?: number;
    initialDelayMs?: number;
    backoff?: number;
    jitter?: boolean;
    onRetry?: (err: any, attempt: number) => void;
  } = {}
): Promise<T> {
  const {
    retries = 3,
    initialDelayMs = 100,
    backoff = 2,
    jitter = true,
    onRetry,
  } = opts;

  let attempt = 0;
  let delay = initialDelayMs;

  while (true) {
    try {
      return await fn();
    } catch (err) {
      attempt++;
      if (attempt > retries) throw err;
      onRetry?.(err, attempt);
      const jitterFactor = jitter ? (1 + (Math.random() - 0.5) * 0.5) : 1; // ±25%
      await new Promise((res) => setTimeout(res, Math.max(0, Math.round(delay * jitterFactor))));
      delay *= backoff;
    }
  }
}